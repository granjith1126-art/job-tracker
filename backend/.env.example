# ==============================================================================
# CareerAI / Job Tracker Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and supply your actual credentials.
# NEVER commit your actual `.env` file to version control.

# Core Security & URLs
# --------------------
# Base JWT and session secret key
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# 32-byte Fernet key for encrypting OAuth tokens at rest (AES-128-CBC + HMAC-SHA256)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAREER_RADAR_ENCRYPTION_KEY=

# Base URLs
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://127.0.0.1:8000

# AI Provider Keys
# ----------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# CAREER RADAR CONNECTED ACCOUNTS OAUTH CREDENTIALS
# ==============================================================================

# 1. GitHub OAuth App
# --------------------
# Setup instructions:
# 1. Go to https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# 2. Application Name: CareerAI Radar
# 3. Homepage URL: http://localhost:5173
# 4. Authorization callback URL: http://127.0.0.1:8000/api/career-radar/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/career-radar/github/callback

# 2. Google / YouTube Data API (Read-Only)
# ----------------------------------------
# Setup instructions:
# 1. Go to Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# 2. Application type: Web application
# 3. Authorized redirect URIs: http://127.0.0.1:8000/api/career-radar/google/callback
# 4. Enable YouTube Data API v3 in API Library
# Note: When using modern RFC 7636 PKCE (S256), GOOGLE_CLIENT_SECRET is not required for public clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/career-radar/google/callback
YOUTUBE_API_KEY=
OAUTH_TOKEN_ENCRYPTION_KEY=

# 3. Instagram (Meta for Developers)
# -----------------------------------
# Setup instructions:
# 1. Go to Meta for Developers (https://developers.facebook.com/apps) -> Create App
# 2. Add product: "Instagram" (API Setup with Instagram Login)
# 3. Add Valid OAuth Redirect URI: http://127.0.0.1:8000/api/career-radar/instagram/callback
# 4. Permissions requested: instagram_business_basic (for Creator & Business profiles)
# 5. For development: add your Instagram account under App Roles -> Roles / Instagram Testers
META_CLIENT_ID=
META_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/career-radar/instagram/callback

# ==============================================================================
# OPTIONAL LIVE JOB FEED PROVIDERS
# ==============================================================================
# Adzuna Job API (Register at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble Job API (Register at https://jooble.org/api/about)
JOOBLE_API_KEY=
